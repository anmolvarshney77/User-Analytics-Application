PORT=4000
# Copy to server/.env and set your real values (never commit server/.env).
# Use a database name in the path (e.g. /analytics) before the query string.
# Add authSource=admin if Atlas returns "bad auth" for your database user (common for SCRAM users).
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/analytics?retryWrites=true&w=majority&authSource=admin
# Comma-separated origins (no trailing slashes). Include Next.js dev server.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4000,http://127.0.0.1:4000
